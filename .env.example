# SecureFlow Environment Configuration Template
NODE_ENV=production
PORT=5000

# Database Configuration (PostgreSQL)
# If DB_HOST is omitted, backend automatically initializes local SQLite database (secureflow.db)
DB_HOST=postgres
DB_PORT=5432
DB_USER=dbadmin
DB_PASSWORD=your_secure_db_password
DB_NAME=secureflow

# Telemetry settings
PROMETHEUS_METRICS_PATH=/metrics
